{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug huidige CMake-target",
            "type": "cppdbg",
            "request": "launch",
            "preLaunchTask": "Bouwen",
            "program": "${command:cmake.launchTargetPath}",
            "cwd": "${workspaceFolder}",
            "environment": [
                {
                    "name": "ASAN_OPTIONS",
                    "value": "detect_stack_use_after_return=1:abort_on_error=1"
                },
                {
                    "name": "UBSAN_OPTIONS",
                    "value": "print_stacktrace=1"
                }
            ],
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Pretty printing aanzetten",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        }
    ]
}
